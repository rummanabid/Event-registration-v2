<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= reg.waitlisted ? 'Waitlist Confirmed' : 'Registration Successful' %> — Events QR Check-in</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="<%= isEmbed ? 'embed-mode' : '' %>">
  <% if (!isEmbed) { %>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="4" height="4"/>
          <rect x="9" y="14" width="4" height="4"/>
        </svg>
        Events QR Check-in
      </a>
    </div>
  </header>
  <% } %>

  <main class="success-main">
    <div class="success-container">

      <% if (reg.waitlisted) { %>
      <!-- WAITLIST STATE -->
      <div class="success-header waitlist-header">
        <div class="success-icon waitlist-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h1>You're on the Waitlist</h1>
        <p>Hi <strong><%= reg.full_name %></strong> — you've been added to the waitlist for <strong><%= reg.event_name %></strong>.</p>
        <p class="text-muted" style="font-size:.9rem;margin-top:8px">We'll contact you at <strong><%= reg.email %></strong> if a spot opens up.</p>
      </div>

      <div class="event-info card">
        <h3><%= reg.event_name %></h3>
        <% if (reg.event_date) { %><p><strong>Date:</strong> <%= formatDate(reg.event_date) %></p><% } %>
        <% if (reg.event_location) { %><p><strong>Location:</strong> <%= reg.event_location %></p><% } %>
      </div>

      <% } else { %>
      <!-- SUCCESS STATE -->
      <div class="success-header">
        <div class="success-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h1>You're Registered!</h1>
        <p>Welcome, <strong><%= reg.full_name %></strong>. Save your QR code below.</p>
      </div>

      <div class="warning-banner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        ⚠️ Save or screenshot this QR code now — you'll need it to check in at the event.
      </div>

      <div class="qr-section">
        <img src="<%= qrDataUrl %>" alt="Your QR Code" class="qr-image" />
      </div>

      <div class="download-section">
        <button onclick="downloadBadgeCard()" class="btn btn-download btn-full">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          DOWNLOAD YOUR BADGE CARD
        </button>
        <canvas id="badge-canvas" style="display:none"></canvas>
      </div>

      <div class="share-section card">
        <h3>Share Your QR Code</h3>
        <div class="share-buttons">
          <%
            const mailSubject = encodeURIComponent('Your registration for ' + reg.event_name);
            const mailBody = encodeURIComponent(
              'Hi ' + reg.full_name + ',\n\nYou are registered for ' + reg.event_name + '.\n\n' +
              (reg.event_date ? 'Date: ' + formatDate(reg.event_date) + '\n' : '') +
              (reg.event_location ? 'Location: ' + reg.event_location + '\n' : '') +
              '\nSave your QR code — you will need it to check in at the event.'
            );
          %>
          <a href="mailto:<%= reg.email %>?subject=<%= mailSubject %>&body=<%= mailBody %>" class="btn btn-outline btn-share">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email to Myself
          </a>
          <% if (reg.phone) { %>
          <%
            const waPhone = reg.phone.replace(/\D/g, '');
            const waText = encodeURIComponent(
              'Hi ' + reg.full_name + '! You are registered for ' + reg.event_name + '. ' +
              (reg.event_date ? 'Date: ' + formatDate(reg.event_date) + '. ' : '') +
              (reg.event_location ? 'Location: ' + reg.event_location + '. ' : '') +
              'Save your QR code to check in at the event.'
            );
          %>
          <a href="https://wa.me/<%= waPhone %>?text=<%= waText %>" target="_blank" class="btn btn-outline btn-share btn-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Send via WhatsApp
          </a>
          <% } %>
        </div>
      </div>

      <div class="event-info card">
        <h3><%= reg.event_name %></h3>
        <% if (reg.event_date) { %><p><strong>Date:</strong> <%= formatDate(reg.event_date) %></p><% } %>
        <% if (reg.event_location) { %><p><strong>Location:</strong> <%= reg.event_location %></p><% } %>
        <div class="calendar-links">
          <% if (reg.event_date) { %>
          <% const gcalDate = new Date(reg.event_date); %>
          <% const gcalStart = gcalDate.toISOString().replace(/[-:]/g,'').split('.')[0]+'Z'; %>
          <% const gcalEnd = new Date(gcalDate.getTime()+2*3600000).toISOString().replace(/[-:]/g,'').split('.')[0]+'Z'; %>
          <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=<%= encodeURIComponent(reg.event_name) %>&dates=<%= gcalStart %>/<%= gcalEnd %><%= reg.event_location ? '&location='+encodeURIComponent(reg.event_location) : '' %>" target="_blank" class="btn btn-sm btn-outline">Add to Google Calendar</a>
          <% } %>
          <a href="/calendar/<%= reg.event_id %>.ics" class="btn btn-sm btn-outline">Save to Apple / Outlook Calendar</a>
        </div>
      </div>
      <% } %>

    </div>
  </main>

  <% if (!isEmbed) { %>
  <footer class="site-footer">
    <p>Events QR Check-in &copy; <%= new Date().getFullYear() %></p>
  </footer>
  <% } %>

  <% if (!reg.waitlisted) { %>
  <script>
    const ATTENDEE_NAME    = `<%- reg.full_name.replace(/`/g, '\\`') %>`;
    const ATTENDEE_COMPANY = `<%- (reg.company || '').replace(/`/g, '\\`') %>`;
    const EVENT_NAME       = `<%- reg.event_name.replace(/`/g, '\\`') %>`;
    const EVENT_SLUG       = '<%= reg.event_slug %>';

    // Brand colour matching Al Jammaz Technologies identity
    const BRAND_GREEN  = '#1a5c2a';
    const BRAND_LIGHT  = '#e8f5e9';

    function downloadBadgeCard() {
      // Use the already-loaded QR image on the page — avoids re-fetching the data URL
      const qrImg = document.querySelector('.qr-image');
      if (!qrImg) return;

      const canvas = document.getElementById('badge-canvas');
      const W = 720, H = 430;
      canvas.width = W; canvas.height = H;
      const ctx = canvas.getContext('2d');

      function render() {
        ctx.clearRect(0, 0, W, H);

        // ── White body background ──
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, W, H);

        // ── Green header bar ──
        const HDR = 90;
        ctx.fillStyle = BRAND_GREEN;
        ctx.fillRect(0, 0, W, HDR);

        // ── Sunburst logo in header ──
        const LOGO_SIZE = 68;
        const lx = 14, ly = 11;
        drawSunburst(ctx, lx, ly, LOGO_SIZE, '#ffffff');

        // ── Company name in header ──
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'left';
        ctx.font = 'bold 13px system-ui, sans-serif';
        ctx.fillText('al jammaz technologies', lx + LOGO_SIZE + 14, HDR / 2 + 6);
        ctx.font = '11px system-ui, sans-serif';
        ctx.fillStyle = 'rgba(255,255,255,0.75)';
        ctx.fillText('الجماز للتكنولوجيا', lx + LOGO_SIZE + 14, HDR / 2 - 10);

        // ── QR code — right side ──
        const QR_SIZE  = 210;
        const QR_X     = W - QR_SIZE - 28;
        const QR_Y     = HDR + (H - HDR - QR_SIZE) / 2;

        // Light green QR background
        ctx.fillStyle = BRAND_LIGHT;
        roundRect(ctx, QR_X - 10, QR_Y - 10, QR_SIZE + 20, QR_SIZE + 20, 14);
        ctx.fill();
        ctx.drawImage(qrImg, QR_X, QR_Y, QR_SIZE, QR_SIZE);

        // ── Left side text ──
        const TX = 32;
        let TY = HDR + 34;

        // Event label
        ctx.fillStyle = BRAND_GREEN;
        ctx.font = 'bold 11px system-ui, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText('EVENT', TX, TY);
        TY += 18;

        // Event name
        ctx.fillStyle = '#374151';
        ctx.font = '15px system-ui, sans-serif';
        const maxW = QR_X - TX - 16;
        TY = wrapText(ctx, EVENT_NAME, TX, TY, maxW, 20) + 24;

        // Divider
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(TX, TY - 10); ctx.lineTo(QR_X - 16, TY - 10); ctx.stroke();

        // Attendee label
        ctx.fillStyle = BRAND_GREEN;
        ctx.font = 'bold 11px system-ui, sans-serif';
        ctx.fillText('ATTENDEE', TX, TY + 4);
        TY += 22;

        // Name
        ctx.fillStyle = '#111827';
        ctx.font = `bold 28px system-ui, sans-serif`;
        TY = wrapText(ctx, ATTENDEE_NAME, TX, TY, maxW, 34) + 14;

        // Company
        if (ATTENDEE_COMPANY) {
          ctx.fillStyle = '#6b7280';
          ctx.font = '16px system-ui, sans-serif';
          wrapText(ctx, ATTENDEE_COMPANY, TX, TY, maxW, 22);
        }

        // ── Footer strip ──
        ctx.fillStyle = BRAND_LIGHT;
        ctx.fillRect(0, H - 36, W, 36);
        ctx.fillStyle = BRAND_GREEN;
        ctx.font = '12px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Show this QR code at the event check-in desk', W / 2, H - 14);

        // ── Bottom border accent ──
        ctx.fillStyle = BRAND_GREEN;
        ctx.fillRect(0, H - 4, W, 4);

        // Download
        const link = document.createElement('a');
        link.download = `${EVENT_SLUG}-badge.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      }

      if (qrImg.complete && qrImg.naturalWidth) {
        render();
      } else {
        qrImg.onload = render;
      }
    }

    function drawSunburst(ctx, x, y, size, color) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(x, y, size, size);
      ctx.clip();

      const ox = x + 1, oy = y + size - 1;
      const NUM = 14;
      ctx.strokeStyle = color;
      ctx.lineWidth = size / 28;
      ctx.lineCap = 'butt';

      for (let i = 0; i <= NUM; i++) {
        const angle = (i / NUM) * Math.PI / 2;
        const len = size * 2.5;
        ctx.beginPath();
        ctx.moveTo(ox, oy);
        ctx.lineTo(ox + Math.cos(angle) * len, oy - Math.sin(angle) * len);
        ctx.stroke();
      }
      ctx.restore();

      ctx.strokeStyle = color;
      ctx.lineWidth = size / 28;
      ctx.strokeRect(x, y, size, size);
    }

    function roundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }

    function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
      const words = text.split(' ');
      let line = '';
      for (let i = 0; i < words.length; i++) {
        const test = line + words[i] + ' ';
        if (ctx.measureText(test).width > maxWidth && i > 0) {
          ctx.fillText(line.trim(), x, y);
          line = words[i] + ' ';
          y += lineHeight;
        } else { line = test; }
      }
      ctx.fillText(line.trim(), x, y);
      return y;
    }
  </script>
  <% } %>
</body>
</html>
