<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Badges — <%= event.name %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    @media print {
      .no-print { display: none !important; }
      .site-header, .site-footer, .badges-toolbar { display: none !important; }
      body { background: white; }
      .badges-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; padding: 0; }
      .badge-card { break-inside: avoid; border: 1px solid #ccc; border-radius: 0; margin: 0; box-shadow: none; }
      @page { margin: 10mm; size: A4; }
    }
  </style>
</head>
<body>
  <header class="site-header no-print">
    <div class="header-inner">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="4" height="4"/>
          <rect x="9" y="14" width="4" height="4"/>
        </svg>
        Events QR Check-in
      </a>
      <nav class="site-nav">
        <a href="/admin">Admin</a>
      </nav>
    </div>
  </header>

  <div class="badges-toolbar no-print">
    <div class="container">
      <div class="badges-toolbar-inner">
        <div>
          <h1>Badges — <%= event.name %></h1>
          <p class="text-muted"><%= registrations.length %> attendee<%= registrations.length !== 1 ? 's' : '' %></p>
        </div>
        <div class="badges-toolbar-actions">
          <a href="/admin" class="btn btn-outline">← Back</a>
          <button onclick="window.print()" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print Badges
          </button>
        </div>
      </div>
    </div>
  </div>

  <main>
    <% if (registrations.length === 0) { %>
    <div class="container" style="padding: 48px 20px;">
      <div class="empty-state">
        <p>No confirmed registrations for this event yet.</p>
        <a href="/admin" class="btn btn-primary" style="margin-top:16px">Back to Admin</a>
      </div>
    </div>
    <% } else { %>
    <div class="badges-grid">
      <% registrations.forEach(r => { %>
      <div class="badge-card">
        <div class="badge-event"><%= event.name %></div>
        <% if (event.date) { %>
        <div class="badge-date"><%= formatDate(event.date) %></div>
        <% } %>
        <div class="badge-name"><%= r.full_name %></div>
        <% if (r.company) { %>
        <div class="badge-company"><%= r.company %></div>
        <% } %>
        <div class="badge-qr">
          <img src="<%= r.qrDataUrl %>" alt="QR Code" width="100" height="100" />
        </div>
        <% if (event.location) { %>
        <div class="badge-location"><%= event.location %></div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </main>
</body>
</html>
