<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Events QR Check-in</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="4" height="4"/>
          <rect x="9" y="14" width="4" height="4"/>
        </svg>
        Events QR Check-in
      </a>
      <nav class="site-nav">
        <a href="/" class="active">Home</a>
        <a href="/admin">Admin</a>
        <a href="/scan">Scanner</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-badge">Event Management Platform</div>
        <h1 class="hero-title">Events QR Check-in</h1>
        <p class="hero-tagline">Manage events, register attendees, scan QR codes, and print badges — all in one place.</p>
        <div class="hero-actions">
          <a href="/admin" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Admin Dashboard
          </a>
          <a href="/scan" class="btn btn-outline btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7V1h-6M1 7V1h6M23 17v6h-6M1 17v6h6M8 12h8M12 8v8"/></svg>
            QR Scanner
          </a>
        </div>
      </div>
    </section>

    <!-- Global Stats -->
    <% if (totals.total_events > 0) { %>
    <section class="home-stats-section">
      <div class="container">
        <div class="home-stats-grid">
          <div class="home-stat">
            <span class="home-stat-value"><%= totals.total_events %></span>
            <span class="home-stat-label">Total Events</span>
          </div>
          <div class="home-stat">
            <span class="home-stat-value"><%= totals.total_registrations %></span>
            <span class="home-stat-label">Registrations</span>
          </div>
          <div class="home-stat">
            <span class="home-stat-value"><%= totals.total_checked_in %></span>
            <span class="home-stat-label">Checked In</span>
          </div>
          <div class="home-stat">
            <span class="home-stat-value home-stat-pct">
              <%= totals.total_registrations > 0 ? Math.round((totals.total_checked_in / totals.total_registrations) * 100) : 0 %>%
            </span>
            <span class="home-stat-label">Check-in Rate</span>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <section class="action-cards-section">
      <div class="container">
        <div class="action-grid action-grid-2">
          <a href="/admin" class="action-card">
            <div class="action-card-icon admin-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
            <h2>Admin Dashboard</h2>
            <p>Create events, manage form fields, view registrations, export CSV and Excel reports, print badges.</p>
            <span class="action-link">Go to Admin &rarr;</span>
          </a>
          <a href="/scan" class="action-card">
            <div class="action-card-icon scan-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7V1h-6M1 7V1h6M23 17v6h-6M1 17v6h6"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </div>
            <h2>QR Scanner</h2>
            <p>Scan attendee QR codes to check them in. Manual search included for lost codes.</p>
            <span class="action-link">Open Scanner &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <% if (events.length > 0) { %>
    <section class="events-section">
      <div class="container">
        <h2 class="section-title">Your Events</h2>
        <div class="events-grid">
          <% events.forEach(event => { %>
          <div class="event-card">
            <div class="event-card-header">
              <h3 class="event-name"><%= event.name %></h3>
              <% if (event.date) { %>
              <span class="event-date-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <%= formatDate(event.date) %>
              </span>
              <% } %>
              <% if (event.location) { %>
              <span class="event-location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= event.location %>
              </span>
              <% } %>
            </div>
            <div class="event-stats">
              <span class="stat"><strong><%= event.registration_count %></strong> registered</span>
              <span class="stat"><strong><%= event.checked_in_count %></strong> checked in</span>
              <% if (event.capacity) { %><span class="stat text-muted">Cap: <%= event.capacity %></span><% } %>
            </div>
            <div class="event-card-actions">
              <a href="/embed?event=<%= event.slug %>" class="btn btn-sm btn-outline" target="_blank">Register</a>
              <a href="/scan" class="btn btn-sm btn-outline">Scan</a>
              <a href="/admin#event-<%= event.id %>" class="btn btn-sm btn-primary">Admin</a>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>
  </main>

  <footer class="site-footer">
    <p>Events QR Check-in &copy; <%= new Date().getFullYear() %></p>
  </footer>
</body>
</html>
